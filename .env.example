# Telegram bot
TELEGRAM_TOKEN=

# Postgres (docker-compose runs its own postgres service; POSTGRES_URL is
# set for you there via the "postgres" service name. Set it yourself only
# when running the app outside docker-compose, e.g. POSTGRES_URL=jdbc:postgresql://localhost:5432/accounting)
POSTGRES_DB=accounting
POSTGRES_USER=
POSTGRES_PASSWORD=

# Admin HTTP API
ADMIN_API_PORT=8081
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-in-production
# Comma-separated list of origins allowed to call the admin API (CORS).
# Only matters when hitting the API directly, e.g. from `npm run dev`;
# the dockerized admin-frontend talks to it same-origin via nginx, so CORS
# doesn't apply there.
ADMIN_CORS_ORIGINS=http://localhost:5173

# Admin web UI (nginx serving admin-frontend, reverse-proxying /api to the
# admin API above)
ADMIN_FRONTEND_PORT=8080
