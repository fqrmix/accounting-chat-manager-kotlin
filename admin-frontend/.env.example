# Base URL of the Ktor admin REST API as seen by the browser.
# In dev leave it as /api (Vite proxies it to the Ktor service; see vite.config.ts).
# In production point it at wherever the API is served, e.g. https://admin.example.com/api
VITE_API_BASE_URL=/api

# Dev-only: where Vite proxies /api to. Defaults to http://localhost:8081.
# API_PROXY_TARGET=http://localhost:8081
