server {
    listen 80;

    # Forwarded as-is (no URI part on proxy_pass) so the Ktor backend sees
    # the same /api/... path the browser requested.
    location /api/ {
        proxy_pass http://chat-manager-app:${ADMIN_API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Browsers send Origin even on same-origin POSTs; drop it so the
        # backend's CORS plugin (which only knows about ADMIN_CORS_ORIGINS,
        # not this nginx's own port) doesn't reject it as cross-origin.
        proxy_set_header Origin "";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
